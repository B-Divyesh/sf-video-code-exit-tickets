{
  "name": "video-code-exit-tickets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "dev:extension": "wxt",
    "build": "npm run build:extension && npm run build:site && npm run package:extension",
    "build:extension": "wxt build",
    "package:extension": "wxt zip && mkdir -p dist/site/downloads && cp .output/*-chrome.zip dist/site/downloads/run-before-next-chrome.zip",
    "build:site": "vite build --config site/vite.config.ts",
    "pretest": "npm run build",
    "test": "playwright test",
    "test:unit": "vitest run",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/chrome": "^0.0.322",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.4",
    "wxt": "0.20.6"
  }
}
